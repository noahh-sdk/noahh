{
    "noahh": "@PROJECT_VERSION@@PROJECT_VERSION_SUFFIX@",
    "gd": {
        "win": "*",
        "mac": "*",
        "android": "*",
        "ios": "*"
    },
    "id": "noahh.loader",
    "version": "@PROJECT_VERSION@@PROJECT_VERSION_SUFFIX@",
    "name": "Noahh",
    "developer": "Noahh Team",
    "description": "The Noahh mod loader",
    "links": {
        "community": "https://discord.com/invite/9e43WMKzhp",
        "homepage": "https://noahh-sdk.org",
        "source": "https://github.com/noahh-sdk/noahh"
    },
    "repository": "https://github.com/noahh-sdk/noahh",
    "resources": {
        "fonts": {
            "mdFont": {
                "path": "fonts/Ubuntu-Regular.ttf",
                "size": 80
            },
            "mdFontB": {
                "path": "fonts/Ubuntu-Bold.ttf",
                "size": 80
            },
            "mdFontI": {
                "path": "fonts/Ubuntu-Italic.ttf",
                "size": 80
            },
            "mdFontBI": {
                "path": "fonts/Ubuntu-BoldItalic.ttf",
                "size": 80
            },
            "mdFontMono": {
                "path": "fonts/UbuntuMono-Regular.ttf",
                "size": 80
            }
        },
        "sprites": [
            "images/*.png",
            "swelve/*.png"
        ],
        "files": [
            "sounds/*.ogg",
            "about.md",
            "changelog.md",
            "support.md",
            "mod.json",
            "version"
        ],
        "spritesheets": {
            "LogoSheet": [
                "logos/*.png"
            ],
            "APISheet": [
                "*.png"
            ],
            "BlankSheet": [
                "blanks/*.png"
            ],
            "EventSheet": [
                "modtober/*.png"
            ]
        }
    },
    "settings": {
        "noahh-settings-info": {
            "type": "custom:settings-info"
        },
        "auto-check-updates": {
            "type": "bool",
            "default": true,
            "name": "Check For Updates",
            "description": "Automatically check for <cy>Noahh</c> updates on startup"
        },
        "disable-last-crashed-popup": {
            "type": "bool",
            "default": false,
            "name": "Disable Crash Popup",
            "description": "Disables the popup at startup asking if you'd like to send a bug report; intended for developers"
        },
        "enable-noahh-theme": {
            "type": "bool",
            "default": true,
            "name": "Enable Noahh-Themed Colors",
            "description": "When enabled, the Noahh menu has a <ca>Noahh-themed color scheme</c>. <cy>This does not affect any other menus!</c>"
        },
        "infinite-local-mods-list": {
            "type": "bool",
            "default": false,
            "name": "Expand Installed Mods List",
            "description": "Make the installed mods list a single infinite scrollable list instead of having pages"
        },
        "copy-mods": {
            "type": "custom:copy-mods"
        },
        "developer-title": {
            "type": "title",
            "name": "Developer Settings"
        },
        "show-platform-console": {
            "type": "bool",
            "default": false,
            "name": "Show Platform Console",
            "description": "Show the native console (if one exists). <cr>This setting is meant for developers</c>",
            "platforms": [
                "win",
                "mac"
            ],
            "requires-restart": true
        },
        "restart-button": {
            "type": "bool",
            "default": false,
            "name": "Show Restart Button",
            "description": "Show a button in the Noahh Menu to restart the game"
        },
        "console-log-level": {
            "type": "string",
            "default": "info",
            "name": "Console Log Level",
            "description": "Sets the log level for the <cb>platform console</c>.",
            "one-of": ["trace", "debug", "info", "warn", "error"]
        },
        "file-log-level": {
            "type": "string",
            "default": "info",
            "name": "File Log Level",
            "description": "Sets the log level for the <cb>log files</c>.",
            "one-of": ["trace", "debug", "info", "warn", "error"]
        },
        "log-retention-period": {
            "type": "int",
            "default": 30,
            "min": 0,
            "max": 365,
            "name": "Log Retention Period",
            "description": "The number of days to keep logs for. Logs older than this will be deleted every launch. 0 to disable deletion."
        },
        "log-milliseconds": {
            "type": "bool",
            "default": false,
            "name": "Log Milliseconds",
            "description": "Shows milliseconds in all logs"
        },
        "log-thread": {
            "type": "bool",
            "default": true,
            "name": "Log Thread",
            "description": "Pushes all logs to a worker thread that handles console & file writing. This makes logging much faster, especially on Windows, but if your console can't keep up, it will see stale logs and might miss some.",
            "requires-restart": true
        },
        "verbose-curl-logs": {
            "type": "bool",
            "default": false,
            "name": "Verbose Curl Logs",
            "description": "When performing web requests, prints detailed information about the request to the logs. Useful for developers wanting to debug network issues."
        },
        "curl-dns": {
            "type": "string",
            "name": "Web DNS Server",
            "default": "Cloudflare DoH",
            "one-of": [
                "System",
                "Cloudflare",
                "Google",
                "Cloudflare DoH"
            ]
        },
        "server-cache-size-limit": {
            "type": "int",
            "default": 20,
            "min": 1,
            "max": 100,
            "name": "Server Cache Size Limit",
            "description": "Limits the size of the cache used for loading mods. Higher values result in higher memory usage."
        }
    },
    "issues": {
        "info": "Post your issues on the <cp>Noahh Github Repository</c>. <cy>Please follow the standard issue format</c>.",
        "url": "https://github.com/noahh-sdk/noahh/issues/new"
    }
}