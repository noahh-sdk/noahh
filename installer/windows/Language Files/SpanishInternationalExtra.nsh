!insertmacro LANGFILE_EXT SpanishInternational

!pragma warning disable 6030
${LangFileString} MUI_TEXT_WELCOME_INFO_TEXT "Este asistente le guiará durante la instalación de Noahh en su computadora.$\r$\n$\r$\nAntes de iniciar la instalación, asegúrese de que Geometry Dash no se está ejecutando$\r$\n$\r$\n$_CLICK"
${LangFileString} MUI_UNTEXT_WELCOME_INFO_TEXT "Este asistente le guiará durante la desinstalación de Noahh.$\r$\n$\r$\nAntes de iniciar la desinstalación, asegúrese de que Geometry Dash no se está ejecutando.$\r$\n$\r$\n$_CLICK"
!pragma warning default 6030

; installer

${LangFileString} NOAHH_TEXT_GD_MISSING "$\r$\n$\r$\n¡Geometry Dash no está instalado en esta carpeta!"
${LangFileString} NOAHH_TEXT_GD_OLD "$\r$\n$\r$\n¡Su versión de Geometry Dash es demasiado antigua para esta versión de Noahh!"
${LangFileString} NOAHH_TEXT_MOD_LOADER_ALREADY_INSTALLED "¡Esta carpeta ya tiene otros mods instalados!$\r$\nVan a ser sobreescritos por Noahh. (the dll trademark)"

; uninstaller

${LangFileString} NOAHH_UNTEXT_NOAHH_MISSING "¡Noahh no está instalado en esta carpeta!"

